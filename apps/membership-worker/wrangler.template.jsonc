// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "cloudflare-only-saas-membership-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  "vars": {
    "ENVIRONMENT": "local",
    "DEBUG_DELIVERY": "true",
    // M0 / Solo profile (cloudflare-only-saas ships single-user): caps each account at its one
    // personal organization. Set "false" to restore the full multi-tenant
    // baseline. Must match api-edge/identity-worker. See specs/profiles/solo-m0.md.
    "SOLO_MODE": "true"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev",
        "DEBUG_DELIVERY": "true",
        "SOLO_MODE": "true"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage",
        "DEBUG_DELIVERY": "true",
        "SOLO_MODE": "true"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cloudflare-only-saas-stage",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "POLICY_WORKER",
          "service": "cloudflare-only-saas-policy-worker-stage"
        },
        {
          "binding": "BILLING_WORKER",
          "service": "cloudflare-only-saas-billing-worker-stage"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "cloudflare-only-saas-notifications-worker-stage"
        }
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod",
        "DEBUG_DELIVERY": "false",
        "SOLO_MODE": "true"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cloudflare-only-saas-prod",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "POLICY_WORKER",
          "service": "cloudflare-only-saas-policy-worker-prod"
        },
        {
          "binding": "BILLING_WORKER",
          "service": "cloudflare-only-saas-billing-worker-prod"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "cloudflare-only-saas-notifications-worker-prod"
        }
      ]
    }
  }
}
